ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173

API_KEY=

API_DEBUG=False

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

CACHE_RECENT_EPISODES_HOURS=2
CACHE_EPISODES_HOURS=1

MIRURO_BASE_URL=

# curl_cffi browser TLS fingerprint to impersonate (bypasses Cloudflare bot detection). Example: chrome1XX
PIPE_IMPERSONATE=

PIPE_USER_AGENT=

PIPE_EXTRA_HEADERS={}

# --- Only needed on cloud nodes (relay Telegram alerts through the home node) ---
NOTIFY_RELAY_URL=

# --- Only needed on the Mac (mac_agent/) ---
# Same NOTIFY_RELAY_URL above, pointed at the home node's ZeroTier address, e.g.
# http://10.147.19.131:8848
NODE_ID=
MAC_AGENT_POLL_INTERVAL_SECONDS=1800

# --- cf_refresher.py / mac_agent/refresher.py: how long to wait, untouched, after launching a
# fully un-instrumented Chrome before attaching to pull the cookie. 20s confirmed working live;
# lower may work too but untested. Default 20 if unset.
NAKED_LAUNCH_WAIT_SECONDS=20
