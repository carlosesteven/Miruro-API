# Copy this to mac_agent/.env and fill in real values. mac_agent/.env is gitignored (see the
# repo's .gitignore .env rule) — never commit real secrets here.

MIRURO_BASE_URL=https://www.miruro.to

# Same shared Redis all 5 API nodes use.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Same shared API_KEY as the rest of the deployment — needed to authenticate against the home
# node's /internal/notify relay (this Mac has no local Hermes install, same situation as the 4
# cloud nodes).
API_KEY=

# Home node's ZeroTier address — this Mac needs to be joined to that same ZeroTier network to
# reach it (and to reach Redis above).
NOTIFY_RELAY_URL=http://10.147.19.131:8848

# Label used in Telegram alerts, e.g. "[nodo: mac]". Defaults to "mac" if unset.
NODE_ID=mac

# How often (seconds) to poll the need_mac_refresh flag as a fallback in case the instant
# pub/sub push was missed (e.g. this Mac was asleep). Default: 30 minutes.
MAC_AGENT_POLL_INTERVAL_SECONDS=1800
